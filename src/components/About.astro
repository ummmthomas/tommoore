---
import { site } from '@data/site';
---

<section id="about" class="container-page scroll-mt-8 py-20 sm:py-28" aria-labelledby="about-heading">
  <div class="grid gap-6 lg:grid-cols-12 lg:gap-16">
    <h2 id="about-heading" class="eyebrow lg:col-span-5">About</h2>
    <div class="space-y-6 lg:col-span-7">
      {site.about.paragraphs.map((p) => <p class="body">{p}</p>)}
    </div>
  </div>
</section>
