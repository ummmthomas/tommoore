---
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

const { github, linkedin, email } = site.contact;
---

<div class="flex items-center gap-1">
  {github && (
    <a
      href={github}
      class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
      target="_blank"
      rel="noreferrer"
      aria-label="GitHub"
    >
      <Icon name="ph:github-logo" class="h-6 w-6" />
    </a>
  )}
  {linkedin && (
    <a
      href={linkedin}
      class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
      target="_blank"
      rel="noreferrer"
      aria-label="LinkedIn"
    >
      <Icon name="ph:linkedin-logo" class="h-6 w-6" />
    </a>
  )}
  {email && (
    <a
      href={`mailto:${email}`}
      class="subtle-link inline-flex h-9 w-9 items-center justify-center rounded"
      aria-label="Email"
    >
      <Icon name="ph:envelope-simple" class="h-6 w-6" />
    </a>
  )}
</div>
