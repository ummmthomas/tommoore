---
import { site } from '@data/site';

const testimonials = site.testimonials;
---

{testimonials.length > 0 && (
  <section id="testimonials" class="container-page scroll-mt-8 pb-20 sm:pb-28" aria-labelledby="testimonials-heading">
    <h2 id="testimonials-heading" class="eyebrow mb-8">Kind words</h2>
    <div class="grid gap-6 md:grid-cols-3">
      {testimonials.map((item) => (
        <figure class="rounded-token bg-bg-blue p-6">
          <blockquote class="caption-regular mb-6">“{item.quote}”</blockquote>
          <figcaption>
            <p class="link-small border-l-4 border-brand-dark py-0.5 pl-4 text-med">
              {item.href ? <a href={item.href} target="_blank" rel="noreferrer">{item.name}</a> : item.name}
            </p>
            <p class="caption-regular pl-5 text-low">{item.title}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
