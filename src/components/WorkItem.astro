---
import type { Project } from '@data/site';
import { withBase } from '../utils/withBase';

interface Props {
  project: Project;
  /** Alternate sections sit on the brand blue background. */
  tinted?: boolean;
}

const { project, tinted = false } = Astro.props;
const href = project.slug ? withBase(`work/${project.slug}`) : undefined;
const details = [
  ['Years', project.years],
  ['Role', project.role],
  ['Scope', project.scope],
  ['Impact', project.impact],
];
---

<article class:list={['py-16 sm:py-20', tinted && 'bg-bg-blue']}>
  <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-16">
    <div class="lg:col-span-5">
      <h3 class="headline">
        {href ? (
          <a href={href} class="group inline-flex items-baseline gap-2 transition-colors hover:text-low">
            {project.title}
            <span aria-hidden="true" class="text-brand-dark transition-transform group-hover:-translate-y-1 group-hover:translate-x-1">↗</span>
          </a>
        ) : (
          project.title
        )}
      </h3>
      <p class="body mt-4 text-low">{project.summary}</p>

      <dl class="mt-8 space-y-4">
        {details.map(([term, value]) => (
          <div>
            <dt class="caption-bold rule-label">{term}</dt>
            <dd class="caption-regular mt-1 pl-5 text-low">{value}</dd>
          </div>
        ))}
      </dl>

      {href && (
        <a href={href} class="link-small mt-8 inline-block">
          Read the case study<span class="sr-only">: {project.title}</span>
        </a>
      )}
    </div>

    <div class="lg:col-span-7">
      {project.image ? (
        <a href={href} tabindex="-1" aria-hidden={href ? 'true' : undefined} class="block transition-opacity hover:opacity-85">
          <img
            src={withBase(project.image.src)}
            alt={project.image.alt}
            class="aspect-[4/3] w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </a>
      ) : (
        <div
          class:list={['flex aspect-[4/3] w-full items-end rounded-token p-8', tinted ? 'bg-body' : 'bg-bg-blue']}
          aria-hidden="true"
        >
          <span class="title text-brand-light">{project.title}</span>
        </div>
      )}
    </div>
  </div>
</article>
