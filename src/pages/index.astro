---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import WorkItem from '../components/WorkItem.astro';
import About from '../components/About.astro';
import ListSection from '../components/ListSection.astro';
import Testimonials from '../components/Testimonials.astro';
import { site } from '@data/site';
---

<Layout>
  <Hero />

  <section id="work" class="scroll-mt-8" aria-labelledby="work-heading">
    <h2 id="work-heading" class="sr-only">Work</h2>
    {site.work.map((project, i) => <WorkItem project={project} tinted={i % 2 === 0} />)}
  </section>

  <About />
  <ListSection id="side-projects" title="Side projects" items={site.sideProjects} />
  <Testimonials />
</Layout>
